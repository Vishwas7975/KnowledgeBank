# ── Environment & secrets ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Dependencies (restore with `composer install`) ──────────────────────
/vendor/

# ── Uploaded documents (real user data — never commit) ───────────────────
/storage/documents/*
!/storage/documents/.gitkeep

# ── Database dumps (ignore root-level dumps; keep database/schema.sql) ────────
# Root-anchored glob: only ignores *.sql files in the project root, not subdirs.
# This lets database/schema.sql be tracked while keeping backup dumps out.
/*.sql
*.sql.bak
*.sqlite
*.sqlite3
*.db

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
/logs/

# ── Cache / build artifacts ─────────────────────────────────────────────
/cache/
/.cache/
*.cache

# ── OS / editor cruft ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
composer.lock
