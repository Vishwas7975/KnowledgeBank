# Copy this file to .env and fill in your own values.
# On Hostinger (or similar shared hosting), set these instead via
# hPanel → PHP Config → Environment Variables — you don't need a .env file there.

# ─── Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=knowledgebank
DB_USER=your_db_user
DB_PASS=your_db_password

# ─── Mail / SMTP (for password-reset OTP emails) ────────────────────────
KNOWLEDGEBANK_MAIL_HOST=smtp.gmail.com
KNOWLEDGEBANK_MAIL_PORT=465
# For Gmail: a 16-character App Password, not your normal account password
KNOWLEDGEBANK_MAIL_USERNAME=your_smtp_username@example.com
KNOWLEDGEBANK_MAIL_PASSWORD=your_smtp_app_password
KNOWLEDGEBANK_MAIL_FROM_NAME=KnowledgeBank
